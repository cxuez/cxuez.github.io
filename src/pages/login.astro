---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTH_STORAGE_KEY, AUTH_TTL_MS, AUTH_CLASS, AUTH_SALT, PASSWORD_HASH } from '../lib/auth';
import { SITE } from '../lib/site-config';
import { url } from '../lib/site';
---

<BaseLayout title="登录" description="登录后查看私密文章、管理自己创建的笔记">
  <div class="auth-card">
    <h1>登录</h1>
    <p class="hint">输入密码后可以查看标记为「私密」的文章，也能管理自己创建的笔记。登录状态保存 7 天。</p>

    <form id="login-form">
      <div class="field">
        <label for="identity">身份标识</label>
        <input
          id="identity"
          name="identity"
          type="text"
          autocomplete="username"
          placeholder={SITE.author}
        />
        <p class="field-hint">
          填一个名字或 ID。只有笔记的 author 与它一致时，你才能删除那篇笔记。留空视为「{SITE.author}」。
        </p>
      </div>
      <div class="field">
        <label for="password">密码</label>
        <input id="password" name="password" type="password" autocomplete="current-password" placeholder="请输入密码" required />
      </div>
      <button class="btn" type="submit">登录</button>
      <p class="form-msg" id="msg" role="status"></p>
    </form>

    <div id="authed-panel" class="when-authed" style="margin-top:20px">
      <p class="form-msg ok" style="margin:0 0 12px">
        已登录（身份：<strong id="cur-user"></strong>），现在可以浏览私密文章、管理自己的笔记了。
      </p>
      <button class="btn btn-ghost" id="logout-btn-2" type="button">退出登录</button>
    </div>

    <hr style="margin:24px 0;border:none;border-top:1px solid var(--border)" />
    <p style="font-size:13px;color:var(--text-faint);margin:0">
      本站是纯静态站点，没有后端。密码校验在浏览器本地完成，仅用于隐藏页面内容，
      请勿用它保护真正敏感的信息。
    </p>
  </div>
</BaseLayout>

<script
  define:vars={{
    authKey: AUTH_STORAGE_KEY,
    authClass: AUTH_CLASS,
    ttl: AUTH_TTL_MS,
    home: url(''),
    salt: AUTH_SALT,
    expected: PASSWORD_HASH,
    defaultUser: SITE.author,
  }}
>
  const form = document.getElementById('login-form');
  const input = document.getElementById('password');
  const identity = document.getElementById('identity');
  const msg = document.getElementById('msg');
  const root = document.documentElement;

  /** 已登录时把身份显示出来 */
  function currentUser() {
    try {
      const raw = localStorage.getItem(authKey);
      if (!raw) return '';
      const data = JSON.parse(raw);
      if (!data || !data.exp || Date.now() > data.exp) return '';
      return data.user || defaultUser;
    } catch (err) {
      return '';
    }
  }
  const curUserEl = document.getElementById('cur-user');
  if (curUserEl) curUserEl.textContent = currentUser();

  async function hashPassword(password) {
    const data = new TextEncoder().encode(`${salt}:${password}`);
    const digest = await crypto.subtle.digest('SHA-256', data);
    return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const value = input?.value ?? '';
    if (!value) {
      msg.textContent = '请输入密码';
      return;
    }
    const hash = await hashPassword(value);
    if (hash !== expected) {
      msg.textContent = '密码不正确，请重试';
      msg.classList.remove('ok');
      input.value = '';
      input.focus();
      return;
    }
    try {
      const user = (identity?.value ?? '').trim() || defaultUser;
      localStorage.setItem(authKey, JSON.stringify({ exp: Date.now() + ttl, user }));
    } catch (err) {}
    root.classList.add(authClass);
    msg.textContent = '登录成功，正在跳转…';
    msg.classList.add('ok');

    const redirect = new URLSearchParams(location.search).get('redirect');
    setTimeout(() => {
      location.assign(redirect ? redirect : home);
    }, 400);
  });

  document.getElementById('logout-btn-2')?.addEventListener('click', () => {
    try {
      localStorage.removeItem(authKey);
    } catch (err) {}
    root.classList.remove(authClass);
    location.assign(home);
  });
</script>

<style>
  .field-hint {
    margin: 6px 0 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-faint);
  }
</style>
