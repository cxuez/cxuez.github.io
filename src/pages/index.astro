---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getVisiblePosts } from '../lib/tags';
import { SITE } from '../lib/site-config';
import { url } from '../lib/site';

// 按日期倒序
const posts = (await getVisiblePosts()).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <section class="hero">
    <h1>{SITE.title}</h1>
    <p>{SITE.subtitle}</p>
  </section>

  {
    posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty">
        <p>还没有文章。在 <code>src/content/posts/</code> 里新建一个 .md 文件试试。</p>
      </div>
    )
  }

  <p style="margin-top:32px;font-size:14px;color:var(--text-faint)">
    共 {posts.length} 篇 · <a href={url('tags/')}>按标签浏览</a> · <a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a>
  </p>
</BaseLayout>
