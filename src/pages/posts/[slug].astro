---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IconLock from '../../components/IconLock.astro';
import DeletePostButton from '../../components/DeletePostButton.astro';
import { formatDate, url } from '../../lib/site';
import { tagHref } from '../../lib/tags';
import { REPO } from '../../lib/site-config';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return sorted.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: sorted[index - 1] ?? null,
      next: sorted[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  prev: CollectionEntry<'posts'> | null;
  next: CollectionEntry<'posts'> | null;
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const { title, date, tags, summary, private: isPrivate, updated } = post.data;
const redirect = encodeURIComponent(url(`posts/${post.id}/`));
/** 该文章在仓库里的文件路径，删除时用 */
const filePath = `${REPO.postsDir}/${post.id}.md`;
---

<BaseLayout title={title} description={summary}>
  <article>
    <header class="article-header">
      <a class="back-link" href={url('')}>← 返回文章列表</a>
      <h1 class="article-title">
        {title}
        {isPrivate && <span class="badge-private"><IconLock />私密</span>}
      </h1>
      <div class="post-meta">
        <time datetime={new Date(date).toISOString()}>发布于 {formatDate(date)}</time>
        {updated && <span>· 更新于 {formatDate(updated)}</span>}
        {
          tags.length > 0 && (
            <span class="post-tags">
              {tags.map((tag) => (
                <a class="tag" href={tagHref(tag)}>#{tag}</a>
              ))}
            </span>
          )
        }
      </div>
    </header>

    {
      isPrivate ? (
        <>
          {/* 未登录：只显示锁卡片，正文保持隐藏 */}
          <div class="private-locked">
            <div class="lock-card">
              <h3><IconLock /> 这是一篇私密文章</h3>
              <p>输入密码登录后即可查看正文，登录状态会保存 7 天。</p>
              <a class="btn btn-ghost btn-inline" href={url(`login/?redirect=${redirect}`)}>去登录</a>
            </div>
          </div>
          <div class="private-content prose">
            <Content />
          </div>
        </>
      ) : (
        <div class="prose">
          <Content />
        </div>
      )
    }

    <div class="post-admin">
      <DeletePostButton
        path={filePath}
        title={title}
        author={post.data.author}
        after="home"
        label="删除这篇笔记"
      />
    </div>

    <nav class="post-nav">
      <span>{next && <a href={url(`posts/${next.id}/`)}>← {next.data.title}</a>}</span>
      <span>{prev && <a href={url(`posts/${prev.id}/`)}>{prev.data.title} →</a>}</span>
    </nav>
  </article>
</BaseLayout>

<style>
  .btn-inline {
    width: auto;
    padding: 8px 18px;
  }
  .post-admin {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px dashed var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--text-faint);
  }
  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 14px;
  }
</style>
