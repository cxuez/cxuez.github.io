---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTACT } from '../lib/site-config';

/**
 * 内联 SVG 图标（24x24，取自 simple-icons）
 * 统一用 currentColor 填充，深浅色主题下都能看清，也和正文链接颜色保持一致
 */
const ICON_PATHS: Record<string, string> = {
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  gitee:
    'M11.984 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.016 0zm6.09 5.333c.328 0 .593.266.592.593v1.482a.594.594 0 0 1-.593.592H9.777c-.982 0-1.778.796-1.778 1.778v5.63c0 .327.266.592.593.592h5.63c.982 0 1.778-.796 1.778-1.778v-.296a.593.593 0 0 0-.592-.593h-4.15a.592.592 0 0 1-.592-.592v-1.482a.593.593 0 0 1 .593-.592h6.815c.327 0 .593.265.593.592v3.408a4 4 0 0 1-4 4H5.926a.593.593 0 0 1-.593-.593V9.778a4.444 4.444 0 0 1 4.445-4.444h8.296Z',
};

/** 外链才开新窗口，mailto 保持当前窗口（交给系统邮件客户端处理） */
const isExternal = (href: string) => /^https?:/i.test(href);
---

<BaseLayout title="关于" description={`关于 ${SITE.author}`}>
  <section class="hero">
    <h1>关于</h1>
  </section>

  <div class="prose">
    <div class="about-avatar">👋</div>

    <p>
      你好，我是 <strong>{SITE.author}</strong>。这里是我的技术笔记本 —— 主要记录日常开发中
      踩过的坑、想明白的原理，以及一些随手记下的配置与代码片段。
    </p>

    <h2>这个博客是怎么搭的</h2>
    <ul>
      <li><strong>Astro</strong>：静态站点生成，默认零 JavaScript，页面首屏很快。</li>
      <li><strong>Markdown</strong>：所有文章都是 <code>src/content/posts/</code> 下的 .md 文件，用 Git 管理版本。</li>
      <li><strong>GitHub Actions</strong>：推送到 main 分支后自动构建并发布到 GitHub Pages。</li>
      <li><strong>Shiki</strong>：构建期做代码高亮，不依赖前端运行时。</li>
    </ul>

    <h2>写作习惯</h2>
    <blockquote>
      <p>能写下来的问题，才是真的想明白了。</p>
    </blockquote>
    <p>
      这里的文章大多先看代码、再写结论，遇到不确定的地方会标注出来。如果你发现哪里写错了，
      欢迎通过 GitHub Issue 告诉我。
    </p>

    <h2>联系我</h2>
    <ul class="contact-list">
      {
        CONTACT.map((item) => (
          <li>
            <span class="contact-icon" aria-hidden="true">
              {item.icon === 'mail' ? (
                <span class="contact-emoji">✉️</span>
              ) : (
                <svg viewBox="0 0 24 24" width="16" height="16" role="img" fill="currentColor">
                  <path d={ICON_PATHS[item.icon]} />
                </svg>
              )}
            </span>
            <span class="contact-label">{item.label}：</span>
            <a
              href={item.href}
              target={isExternal(item.href) ? '_blank' : undefined}
              rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
            >
              {item.handle}
            </a>
          </li>
        ))
      }
    </ul>

    <hr />

    <p style="color:var(--text-faint);font-size:14px">
      想改这段文字和联系方式？编辑 <code>src/pages/about.astro</code>（联系方式列表在
      <code>src/lib/site-config.ts</code> 的 <code>CONTACT</code>），
      或者把内容换成 Markdown 文件后用 <code>content</code> 集合渲染。
    </p>
  </div>
</BaseLayout>

<style>
  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .contact-list li {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }
  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    color: var(--accent);
  }
  .contact-emoji {
    font-size: 14px;
    line-height: 1;
  }
  .contact-label {
    color: var(--text-soft);
  }
</style>
