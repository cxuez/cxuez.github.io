---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisiblePosts, collectTags, tagHref } from '../../lib/tags';

const posts = await getVisiblePosts();
const tags = collectTags(posts);
const total = tags.reduce((sum, t) => sum + t.count, 0);
---

<BaseLayout title="标签" description="所有文章标签">
  <section class="hero">
    <h1>标签</h1>
    <p>共 {tags.length} 个标签、{total} 个标签引用，点击可查看该标签下的全部文章。</p>
  </section>

  {
    tags.length > 0 ? (
      <ul class="tag-cloud">
        {tags.map(({ tag, count, slug }) => (
          <li>
            <a class="tag" href={tagHref(slug)}>
              #{tag}
              <span class="tag-count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty">
        <p>还没有标签。在文章的 frontmatter 里加上 <code>tags: [xxx]</code> 即可。</p>
      </div>
    )
  }
</BaseLayout>

<style>
  .tag-cloud .tag {
    font-size: 14px;
    padding: 6px 14px;
  }
</style>
