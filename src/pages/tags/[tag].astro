---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getVisiblePosts, collectTags, postsOfTag } from '../../lib/tags';
import { url } from '../../lib/site';

export async function getStaticPaths() {
  // 与标签列表页共用同一份「可见文章」与同一套 slug 规则，
  // 保证列表里的计数和这里的文章数永远一致
  const posts = await getVisiblePosts();

  return collectTags(posts).map(({ tag, slug, count }) => ({
    params: { tag: slug },
    props: {
      tag,
      slug,
      count,
      posts: postsOfTag(posts, slug),
    },
  }));
}

interface Props {
  tag: string;
  slug: string;
  count: number;
  posts: Awaited<ReturnType<typeof getVisiblePosts>>;
}

const { tag, slug, count, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的全部文章`}>
  <section class="hero">
    <h1>#{tag}</h1>
    <p>{posts.length} 篇文章 · <a href={url('tags/')}>全部标签</a></p>
  </section>

  {
    posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty">
        <p>
          这个标签下还没有文章。它可能被移除了，或者相关文章还是草稿。
          <a href={url('tags/')}>看看其他标签</a>
        </p>
      </div>
    )
  }
</BaseLayout>
